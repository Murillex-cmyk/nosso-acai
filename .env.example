# Este site é um único arquivo HTML estático (index.html) — não usa
# um servidor Node/Next.js, então não há variáveis de ambiente lidas
# em tempo de build. As duas configurações abaixo são preenchidas
# diretamente no topo do <script> em index.html:
#
#   const SUPABASE_URL = '';
#   const SUPABASE_ANON_KEY = '';
#
# Copie os valores do seu projeto Supabase em
# Project Settings → API → Project URL / anon public key.
#
# IMPORTANTE: a "anon key" é uma chave PÚBLICA por design — ela só
# funciona porque a tabela combo_counts está protegida por Row Level
# Security (veja supabase_schema.sql). NUNCA coloque a "service_role
# key" no index.html nem em qualquer código que rode no navegador.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA
